# =============================================================================
# Repository under test (required)
# =============================================================================
REPO_PATH=

# Target repo language: langchain Language id (python, ts, js, java, ...).
# Ingest + agents follow REPO_LANGUAGE; non-Python test runs need a BYOR runner (below).
# REPO_LANGUAGE=python

# Optional: test framework label in agent prompts (default: pytest for python, else golden seeds)
# ARTS_TEST_FRAMEWORK=jest

# BYOR test execution: module:callable on PYTHONPATH, or place run_tests in <REPO_PATH>/.arts/runner.py
# ARTS_TEST_RUNNER=my_package.arts_runner:run_tests

# BYOR risk metrics (JM1/Radon column layout): for non-Python or custom analyzers
# ARTS_METRICS_EXTRACTOR=my_package.arts_metrics:extract_metrics
# Or <REPO_PATH>/.arts/metrics.py with extract_metrics / extract_code_metrics

# Optional: golden/seed tests directory (default: <REPO_PATH>/seed_data)
# Add your own pytest golden examples before ingest --both; not shipped with ARTS.
# REPO_SEED_PATH=

# =============================================================================
# LLM provider (default: mistral — see shared/run_policy.py)
# =============================================================================
# Supported: mistral | groq | gemini | deepseek | ollama | open_router | github
MODEL_PROVIDER=mistral

# Optional per-agent provider (fallback: MODEL_PROVIDER). Same provider names as above.
# RESEARCHER_MODEL_PROVIDER=groq
# SUMMARIZER_MODEL_PROVIDER=gemini
# DESIGNER_MODEL_PROVIDER=gemini
# REVIEWER_MODEL_PROVIDER=groq
# WRITER_MODEL_PROVIDER=mistral

# Provider API keys (set every provider you use — startup checks all resolved agents)
MISTRAL_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# GitHub Models (provider "github") — LangChain often reads OPENAI_API_KEY
OPENAI_API_KEY=
GITHUB_TOKEN=

# Optional: LangSmith tracing (not required for local runs)
LANGSMITH_API_KEY=

# =============================================================================
# Agent task (optional)
# =============================================================================
# Default demo task (see README); override for your target file:
# USER_TASK=Write unit tests for the file analysis_service/analysis.py

# =============================================================================
# Graph policy
# =============================================================================
RISK_THRESHOLD=0.2
MAX_TEST_ATTEMPTS=3

# =============================================================================
# Logging & runtime
# =============================================================================
LOG_LEVEL=INFO

# LangGraph SQLite checkpoints (default: checkpoints.sqlite in project cwd)
# CHECKPOINT_DB=checkpoints.sqlite

# Chroma: ./data/vector_store (see shared/paths.py)

# =============================================================================
# Local dev: edit RUN / INGEST_MODE in run_local.py
# =============================================================================
