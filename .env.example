# =============================================================================
# Repository under test (required)
# =============================================================================
REPO_PATH=

# Optional: golden/seed tests directory (default: <REPO_PATH>/seed_data)
# REPO_SEED_PATH=

# =============================================================================
# LLM provider (default: mistral — see shared/run_policy.py)
# =============================================================================
# Supported: mistral | groq | gemini | deepseek | ollama | open_router | github
MODEL_PROVIDER=mistral

# Provider API keys (set the one matching MODEL_PROVIDER)
MISTRAL_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# GitHub Models (provider "github") — LangChain often reads OPENAI_API_KEY
OPENAI_API_KEY=
GITHUB_TOKEN=

# Optional: LangSmith tracing (not required for local runs)
LANGSMITH_API_KEY=

# =============================================================================
# Agent task (optional)
# =============================================================================
# USER_TASK=Write unit tests for the file analysis_service/analysis.py

# =============================================================================
# Graph policy
# =============================================================================
RISK_THRESHOLD=0.2
MAX_TEST_ATTEMPTS=3

# =============================================================================
# Logging & runtime
# =============================================================================
LOG_LEVEL=INFO

# LangGraph SQLite checkpoints (default: checkpoints.sqlite in project cwd)
# CHECKPOINT_DB=checkpoints.sqlite

# Chroma: ./data/vector_store (see shared/paths.py)

# =============================================================================
# Local dev: edit RUN / INGEST_MODE in run_local.py
# =============================================================================
